{
  "name": "redlakes-rp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "!apps/discord-bot"
  ],
  "scripts": {
    "setup": "pwsh -ExecutionPolicy Bypass -File ./scripts/setup.ps1",
    "dev": "pwsh -ExecutionPolicy Bypass -File ./scripts/dev-platform.ps1",
    "dev:full": "pwsh -ExecutionPolicy Bypass -File ./scripts/dev-platform.ps1 -AvecBot",
    "hub": "pwsh -ExecutionPolicy Bypass -File ./scripts/hub.ps1",
    "start": "pwsh -ExecutionPolicy Bypass -File ./scripts/dev-platform.ps1",
    "start:web": "pwsh -ExecutionPolicy Bypass -File ./scripts/start-web.ps1",
    "start:api": "pwsh -ExecutionPolicy Bypass -File ./scripts/start-api.ps1",
    "stop": "pwsh -ExecutionPolicy Bypass -File ./scripts/stop.ps1",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run start:dev",
    "dev:terminal": "pwsh -ExecutionPolicy Bypass -File ./scripts/start-terminal.ps1",
    "build:terminal": "npm run build -w @redlakes/narrative-core && npm run build -w terminal",
    "build:web": "cd apps/web && npm run build",
    "build:api": "cd apps/api && npm run build",
    "db:up": "powershell -ExecutionPolicy Bypass -File ./scripts/start-docker.ps1",
    "db:migrate": "cd apps/api && npx prisma migrate dev",
    "sync:grades": "python scripts/generate-rp-catalog.py"
  }
}
