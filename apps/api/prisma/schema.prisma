generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  STAFF
  ADMIN
}

// Rang au sein du STAFF (PLAYER n'en a pas, ADMIN n'en a pas besoin — ADMIN
// = Fondateur, acces total par definition). Sert a distinguer ce que peuvent
// faire les differents membres du staff sans toucher au systeme PLAYER/
// STAFF/ADMIN existant : STAFF reste le portail d'entree ("est staff ou
// pas"), StaffRank affine ensuite ce qu'un compte STAFF a le droit de faire.
enum StaffRank {
  SURVEILLANT
  OFFICIER
  COORDINATEUR_GENERAL
}

enum ApplicationType {
  STAFF
  RECHERCHE
  ADMINISTRATION
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoreCategory {
  MONDE
  SITE
  CHRONOLOGIE
  GUERRES
  CATASTROPHES
  PERSONNAGES
  SCP
  FACTION
  EVENEMENT
}

enum LoreStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TransmissionType {
  MESSAGE
  ANNOUNCE
  MEMBER_JOIN
  MEMBER_LEAVE
  EVENT
  BOOST
}

model User {
  id                String   @id @default(cuid())
  minecraftUuid     String?  @unique
  minecraftUsername String?  @unique
  microsoftId       String?  @unique
  email             String?
  avatarUrl         String?
  discordId         String?  @unique
  discordUsername   String?
  username          String?  @unique
  passwordHash      String?
  role              UserRole @default(PLAYER)
  staffRank         StaffRank?
  onboardedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  activeCharacterId String? @unique
  activeCharacter   Player? @relation("ActiveCharacter", fields: [activeCharacterId], references: [id], onDelete: SetNull)
  players           Player[]               @relation("PlayerCharacters")
  applications     Application[]
  loreArticles     LoreArticle[]          @relation("AuthorArticles")
  sessions         Session[]
  personnelReports PersonnelReport[]
  auditLogs        AuditLog[]
  platformComments PlatformComment[]
  notifications    PlatformNotification[]
  factionsLed      Faction[]              @relation("FactionChef")
  departmentsLed   Department[]           @relation("DepartmentChef")
  teamsLed         Team[]                 @relation("TeamChef")
  sanctionsIssued  Sanction[]             @relation("SanctionIssuedBy")
  sanctionsLifted  Sanction[]             @relation("SanctionLiftedBy")
  scpProposals     ScpObject[]
  scpRevisionsEdited ScpRevision[]
  characterRevisionsEdited CharacterRevision[]
  gameEventRevisionsEdited GameEventRevision[]
  missionsCreated  Mission[] @relation("MissionCreatedBy")
  missionsResolved Mission[] @relation("MissionResolvedBy")
  newsRevisionsEdited        NewsRevision[]
  mapLocationRevisionsEdited MapLocationRevision[]
  loreRevisionsEdited        LoreRevision[]
  classifiedDocuments               ClassifiedDocument[]         @relation("AuthorClassifiedDocuments")
  classifiedDocumentRevisionsEdited ClassifiedDocumentRevision[]
  coreMessages               CoreMessage[]
  coreDmSent                 CoreDirectMessage[] @relation("CoreDmSent")
  coreDmReceived             CoreDirectMessage[] @relation("CoreDmReceived")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model Player {
  id              String             @id @default(cuid())
  userId          String
  activeForUser   User?              @relation("ActiveCharacter")
  grade           String             @default("Civil")
  gradeId         String?
  gradeInfo       Grade?             @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  faction         String             @default("Civil")
  factionId       String?
  factionInfo     Faction?           @relation(fields: [factionId], references: [id], onDelete: SetNull)
  teamName        String?
  teamId          String?
  teamInfo        Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignments     PlayerAssignment[]
  sanctionRecords Sanction[]
  missions        Mission[]
  rpFirstName     String?
  rpLastName      String?
  playtime        Int                @default(0)
  seniority       DateTime           @default(now())
  reputation      Int                @default(50)
  sanctions       Int                @default(0)
  medals          String[]           @default([])
  achievements    Json               @default("[]")
  inventory       Json               @default("[]")
  roleUpdatedAt   DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation("PlayerCharacters", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([gradeId])
  @@index([factionId])
  @@index([teamId])
}

model Application {
  id         String            @id @default(cuid())
  userId     String
  type       ApplicationType
  status     ApplicationStatus @default(PENDING)
  experience String
  motivation String
  staffNote  String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([type])
}

model LoreArticle {
  id                      String       @id @default(cuid())
  slug                    String       @unique
  title                   String
  excerpt                 String?
  content                 String
  category                LoreCategory
  status                  LoreStatus   @default(DRAFT)
  restrictedDepartmentIds String[]     @default([])
  featured                Boolean      @default(false)
  coverImage              String?
  tags                    String[]     @default([])
  authorId                String?
  publishedAt             DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  author                  User?        @relation("AuthorArticles", fields: [authorId], references: [id], onDelete: SetNull)
  revisions               LoreRevision[]

  @@index([status, category])
  @@index([publishedAt])
}

// Snapshot du contenu de LoreArticle juste AVANT chaque edition staff.
model LoreRevision {
  id            String      @id @default(cuid())
  loreArticleId String
  loreArticle   LoreArticle @relation(fields: [loreArticleId], references: [id], onDelete: Cascade)

  title                   String
  excerpt                 String?
  content                 String
  category                LoreCategory
  status                  LoreStatus
  restrictedDepartmentIds String[]
  featured                Boolean
  coverImage              String?
  tags                    String[]

  editedById    String?
  editedBy      User?    @relation(fields: [editedById], references: [id], onDelete: SetNull)
  editedByLabel String?
  createdAt     DateTime @default(now())

  @@index([loreArticleId])
}

enum ClassifiedDocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Documents classifies — meme patron que LoreArticle (auteur, statut,
/// restriction par departement, tags, historique de revisions), scope
/// volontairement proportionne pour un premier passage : les liens vers
/// SCP/evenements/missions/autres documents decrits dans le spec CORE ne
/// sont pas encore modelises en relations (pas de Mission construite,
/// et une jointure many-to-many par type de lien aurait demultiplie la
/// portee sans besoin exprime) — attachments reste une liste d'URLs.
model ClassifiedDocument {
  id                      String                   @id @default(cuid())
  slug                    String                   @unique
  title                   String
  excerpt                 String?
  content                 String
  status                  ClassifiedDocumentStatus @default(DRAFT)
  restrictedDepartmentIds String[]                 @default([])
  factionId               String?
  faction                 Faction?                 @relation(fields: [factionId], references: [id], onDelete: SetNull)
  tags                    String[]                 @default([])
  attachments             String[]                 @default([])
  authorId                String?
  author                  User?                    @relation("AuthorClassifiedDocuments", fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  revisions ClassifiedDocumentRevision[]
  linkedEvents     GameEvent[] @relation("DocumentEvents")
  linkedScpObjects ScpObject[] @relation("DocumentScpObjects")

  @@index([status])
  @@index([factionId])
}

// Snapshot du contenu de ClassifiedDocument juste AVANT chaque edition staff.
model ClassifiedDocumentRevision {
  id         String             @id @default(cuid())
  documentId String
  document   ClassifiedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  title                   String
  excerpt                 String?
  content                 String
  status                  ClassifiedDocumentStatus
  restrictedDepartmentIds String[]
  factionId               String?
  tags                    String[]
  attachments             String[]

  editedById    String?
  editedBy      User?    @relation(fields: [editedById], references: [id], onDelete: SetNull)
  editedByLabel String?
  createdAt     DateTime @default(now())

  @@index([documentId])
}

model GalleryAsset {
  id        String   @id @default(cuid())
  title     String
  url       String
  faction   String?
  type      String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model LinkCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String?
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum PersonnelReportType {
  INCIDENT
  AUTHORIZATION
  MEMO
  EQUIPMENT
}

enum PersonnelReportStatus {
  PENDING
  REVIEWED
  ARCHIVED
}

model PersonnelReport {
  id         String                @id @default(cuid())
  userId     String
  type       PersonnelReportType
  subject    String
  content    String
  status     PersonnelReportStatus @default(PENDING)
  clearance  Int                   @default(2)
  staffNote  String?
  reviewedBy String?
  reviewedAt DateTime?
  factionId  String?
  faction    Faction?              @relation(fields: [factionId], references: [id], onDelete: SetNull)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@index([factionId])
}

/// Canal de communication REDLAKES CORE, scope par faction (meme principe que
/// PersonnelReport.factionId) — factionId null = canal public/Civil, partage
/// par tout personnage sans faction assignee. Un fil par faction, tout le
/// monde dans la faction le voit. La messagerie privee 1-a-1 est un modele
/// separe : voir CoreDirectMessage.
model CoreMessage {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorLabel String
  factionId   String?
  faction     Faction? @relation(fields: [factionId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime @default(now())

  @@index([factionId])
  @@index([createdAt])
}

/// Messagerie privee 1-a-1 de REDLAKES CORE — distincte de CoreMessage
/// (canal partage par faction). senderLabel snapshotte le nom RP + grade au
/// moment de l'envoi, meme convention que CoreMessage.authorLabel.
model CoreDirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("CoreDmSent", fields: [senderId], references: [id], onDelete: Cascade)
  senderLabel String
  recipientId String
  recipient   User      @relation("CoreDmReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  content     String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
}

/// Évènements Discord relayés par le bot, transformés en "transmissions" RP (thème SCP).
/// Aucun message brut privé n'est conservé : les pseudos sont codifiés (codename) et
/// le contenu n'est stocké que pour les salons explicitement publics.
model DiscordTransmission {
  id               String           @id @default(cuid())
  type             TransmissionType
  discordMessageId String?          @unique
  channelId        String?
  channelLabel     String           @default("Secteur non répertorié")
  clearance        Int              @default(3)
  isPublic         Boolean          @default(false)
  codename         String           @default("Entité ███")
  authorHash       String?
  authorDisplay    String?
  title            String
  body             String
  excerpt          String?
  occurredAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())

  @@index([occurredAt])
  @@index([clearance])
  @@index([type])
}

// ─── Couche plateforme (audit, commentaires, notifications, tags) ───────────

enum PlatformEntityType {
  PERSONNEL_REPORT
  APPLICATION
  LORE_ARTICLE
  PLAYER
  USER
  SCP_OBJECT
  SYSTEM_STATE
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED
  ARCHIVED
  RESTORED
  REVIEWED
  STATUS_CHANGED
  COMMENT_ADDED
  CLEARANCE_CHANGED
  ROLE_CHANGED
}

model AuditLog {
  id         String             @id @default(cuid())
  entityType PlatformEntityType
  entityId   String
  action     AuditAction
  actorId    String?
  actorLabel String?
  summary    String
  metadata   Json?
  clearance  Int                @default(1)
  createdAt  DateTime           @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([actorId])
}

model PlatformComment {
  id         String             @id @default(cuid())
  entityType PlatformEntityType
  entityId   String
  authorId   String
  body       String
  internal   Boolean            @default(false)
  deletedAt  DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([authorId])
}

model PlatformNotification {
  id         String              @id @default(cuid())
  userId     String
  title      String
  body       String
  entityType PlatformEntityType?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model PlatformTag {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  color     String?
  createdAt DateTime @default(now())

  entities PlatformEntityTag[]
}

model PlatformEntityTag {
  id         String             @id @default(cuid())
  tagId      String
  entityType PlatformEntityType
  entityId   String
  createdAt  DateTime           @default(now())

  tag PlatformTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, entityType, entityId])
  @@index([entityType, entityId])
}

// ─── REDLAKES CORE — catalogue de grades (lecture seule pour l'instant) ─────
// Peuplé depuis apps/web/src/data/rp-grades.ts. Player.grade reste une
// chaîne libre à ce stade — voir le plan de migration progressive validé.

model Grade {
  id              String      @id @default(cuid())
  slug            String      @unique
  name            String
  branch          String
  tier            String
  /// Niveau d'habilitation reel (1 = public, 5 = Conseil O5) — remplace le
  /// devinage par regex sur le nom (voir grade-clearance.ts, garde comme
  /// filet de securite pour les grades hors catalogue).
  clearanceLevel  Int         @default(1)
  departmentId    String?
  departmentRefId String?
  departmentRef   Department? @relation(fields: [departmentRefId], references: [id], onDelete: SetNull)
  pay             Int?
  quota           Int?
  description     String?
  objectives      String[]    @default([])
  utilities       String[]    @default([])
  accessZones     String[]    @default([])
  siteSections    String[]    @default([])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  players Player[]

  @@index([branch])
  @@index([departmentId])
  @@index([departmentRefId])
}

// ─── REDLAKES CORE — factions et departements (catalogue additif) ──────────
// Peuples depuis apps/web/src/data/factions.ts et site12.ts. Player.faction
// reste une chaine libre a ce stade (meme approche progressive que Grade
// au Lot 1 : catalogue d'abord, relation Player ensuite une fois valide).
// budget est un champ simple pour l'instant ; a terme il sera remplace par
// un Wallet une fois le systeme economique construit.

model Faction {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String?
  description String?
  history     String?
  color       String?
  playable    Boolean  @default(true)
  objectives  String[] @default([])
  chefId      String?
  chef        User?    @relation("FactionChef", fields: [chefId], references: [id], onDelete: SetNull)
  deputyIds   String[] @default([])
  budget      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  departments Department[]
  players     Player[]
  reports     PersonnelReport[]
  coreMessages CoreMessage[]
  relationsAsA FactionRelation[] @relation("FactionRelationA")
  relationsAsB FactionRelation[] @relation("FactionRelationB")
  classifiedDocuments ClassifiedDocument[]
  gameEvents  GameEvent[]

  @@index([playable])
}

enum FactionRelationStatus {
  ALLIE
  NEUTRE
  TENSION
  HOSTILE
}

/// Relation diplomatique entre deux factions (alliance/neutralite/tension/
/// guerre) — non dirigee : stockee une seule fois par paire, factionAId et
/// factionBId ordonnes par id (voir canonicalPair cote service) pour eviter
/// les doublons A-B / B-A.
model FactionRelation {
  id         String                @id @default(cuid())
  factionAId String
  factionA   Faction               @relation("FactionRelationA", fields: [factionAId], references: [id], onDelete: Cascade)
  factionBId String
  factionB   Faction               @relation("FactionRelationB", fields: [factionBId], references: [id], onDelete: Cascade)
  status     FactionRelationStatus @default(NEUTRE)
  note       String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([factionAId, factionBId])
  @@index([factionAId])
  @@index([factionBId])
}

model Department {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  factionId         String?
  faction           Faction? @relation(fields: [factionId], references: [id], onDelete: SetNull)
  omegaTier         String?
  directorGradeName String?
  color             String?
  utilities         String[] @default([])
  objectives        String[] @default([])
  leadership        String[] @default([])
  chefId            String?
  chef              User?    @relation("DepartmentChef", fields: [chefId], references: [id], onDelete: SetNull)
  deputyIds         String[] @default([])
  budget            Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  grades Grade[]
  teams  Team[]

  @@index([factionId])
}

// ─── REDLAKES CORE — equipes (Team) ─────────────────────────────────────────
// Generique, rattachee a un Department (jamais a une Faction directement) et
// jamais un simple reskin des anciennes MTF. Peuplee depuis les gabarits
// d'equipes deja definis dans apps/web/src/data/site12.ts (TeamTemplate),
// plus les escouades FIM du departement Securite (voir Lore Bible :
// remplacement narratif des MTF retirees au Lot 10).

model Team {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  category       String
  composition    String[]   @default([])
  hasMedic       Boolean    @default(false)
  customizableBy String?
  chefId         String?
  chef           User?      @relation("TeamChef", fields: [chefId], references: [id], onDelete: SetNull)
  quota          Int?
  description    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  players  Player[]
  missions Mission[]

  @@index([departmentId])
}

// ─── REDLAKES CORE — historique des affectations (PlayerAssignment) ────────
// Journal append-only : qui a appartenu a quelle Faction/Department/Team,
// depuis quand, jusqu'a quand. Complete les relations "etat courant" deja
// presentes sur Player (gradeId/factionId/teamId) sans les remplacer —
// repond a "qui dirigeait ce departement en janvier ?" plutot que juste
// "qui le dirige maintenant ?". Table polymorphe unique plutot que 3 tables
// quasi identiques (PlayerFaction/PlayerDepartment/PlayerTeam), sur le meme
// principe deja utilise par AuditLog/PlatformComment (entityType+entityId).

enum AssignmentEntityType {
  FACTION
  DEPARTMENT
  TEAM
}

model PlayerAssignment {
  id         String               @id @default(cuid())
  playerId   String
  player     Player               @relation(fields: [playerId], references: [id], onDelete: Cascade)
  entityType AssignmentEntityType
  entityId   String
  role       String?
  note       String?
  startedAt  DateTime             @default(now())
  endedAt    DateTime?
  createdAt  DateTime             @default(now())

  @@index([playerId])
  @@index([entityType, entityId])
  @@index([playerId, entityType, endedAt])
}

// ─── REDLAKES CORE — sanctions ──────────────────────────────────────────────
// Donne un corps a Player.sanctions, jusqu'ici un simple compteur entier mis
// a jour a la main sans aucun enregistrement derriere. Le compteur reste (vue
// rapide sur /profil Discord et les fiches joueur) mais est desormais
// synchronise depuis de vrais enregistrements — raison, type, qui l'a
// prononcee, statut (active/expiree/levee).

enum SanctionType {
  AVERTISSEMENT
  BLAME
  MISE_A_PIED
  RETROGRADATION
  BANNISSEMENT
}

enum SanctionStatus {
  ACTIVE
  EXPIREE
  LEVEE
}

model Sanction {
  id         String         @id @default(cuid())
  playerId   String
  player     Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type       SanctionType
  status     SanctionStatus @default(ACTIVE)
  reason     String
  note       String?
  issuedById String?
  issuedBy   User?          @relation("SanctionIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt   DateTime       @default(now())
  expiresAt  DateTime?
  liftedAt   DateTime?
  liftedById String?
  liftedBy   User?          @relation("SanctionLiftedBy", fields: [liftedById], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([playerId])
  @@index([status])
}

// ─── REDLAKES CORE — missions (LOT D) ───────────────────────────────────────
// Objectif assigne par le staff a un joueur OU une equipe (jamais les deux —
// verifie cote service, pas de contrainte DB pour un "au moins un des deux"
// simple avec Prisma). "reward" reste une String libre plutot qu'un lien vers
// un systeme d'inventaire/economie qui n'existe pas encore.

enum MissionStatus {
  ASSIGNED
  COMPLETED
  FAILED
  CANCELLED
}

model Mission {
  id          String        @id @default(cuid())
  title       String
  description String
  reward      String?
  status      MissionStatus @default(ASSIGNED)
  dueAt       DateTime?

  assignedPlayerId String?
  assignedPlayer   Player? @relation(fields: [assignedPlayerId], references: [id], onDelete: Cascade)
  assignedTeamId   String?
  assignedTeam     Team?   @relation(fields: [assignedTeamId], references: [id], onDelete: Cascade)

  createdById    String?
  createdBy      User?    @relation("MissionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByLabel String?

  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?     @relation("MissionResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedByLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedPlayerId])
  @@index([assignedTeamId])
  @@index([status])
}

// ─── REDLAKES CORE — objets SCP (Wiki) ──────────────────────────────────────
// Contenu riche et structure (classe, niveau de menace, confinement,
// incidents/tests/addendums, stats) — trop specifique pour LoreArticle
// (texte libre generique). Migre depuis apps/web/src/data/scp.ts, jamais
// modelise jusqu'ici malgre 5 fiches deja ecrites.

enum ScpClass {
  Safe
  Euclid
  Keter
  Thaumiel
  Apollyon
}

enum ScpProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ScpObject {
  id                      String            @id @default(cuid())
  slug                    String            @unique
  number                  String
  name                    String
  class                   ScpClass
  threatLevel             Int
  containment             String
  history                 String
  description             String
  image                   String?
  incidents               Json              @default("[]")
  tests                   Json              @default("[]")
  addendums               Json              @default("[]")
  containmentCost         String?
  personnelAssigned       Int?
  breachCount             Int?
  restrictedDepartmentIds String[]          @default([])
  status                  ScpProposalStatus @default(APPROVED)
  submittedById           String?
  submittedBy             User?             @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  staffNote               String?
  reviewedBy              String?
  reviewedAt              DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  revisions               ScpRevision[]
  linkedDocuments         ClassifiedDocument[] @relation("DocumentScpObjects")

  @@index([class])
  @@index([status])
}

// ─── REDLAKES CORE — historique des fiches SCP (ScpRevision) ───────────────
// Snapshot du contenu de ScpObject juste AVANT chaque edition staff (voir
// ScpService.update). Distinct de AuditLog (qui garde un resume + metadata,
// pas le contenu complet) : ici on garde de quoi reconstituer/comparer une
// version passee de la fiche, pas juste "quelque chose a change".

model ScpRevision {
  id                String    @id @default(cuid())
  scpObjectId       String
  scpObject         ScpObject @relation(fields: [scpObjectId], references: [id], onDelete: Cascade)

  number            String
  name              String
  class             ScpClass
  threatLevel       Int
  containment       String
  history           String
  description       String
  image             String?
  incidents         Json
  tests             Json
  addendums         Json
  containmentCost   String?
  personnelAssigned Int?
  breachCount       Int?

  editedById        String?
  editedBy          User?     @relation(fields: [editedById], references: [id], onDelete: SetNull)
  editedByLabel     String?
  createdAt         DateTime  @default(now())

  @@index([scpObjectId])
}

// ─── REDLAKES CORE — personnages importants (Personnages) ──────────────────
// Fiches narratives (directeurs, inspecteurs, commandants...). "faction" reste
// une simple etiquette texte plutot qu'une relation Faction : les valeurs
// existantes melangent des factions ("Fondation SCP") et des unites ("FIM
// Nu-7") qui ne sont pas des factions au sens du modele Faction.

model Character {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  name                    String
  title                   String
  faction                 String
  biography               String
  quotes                  String[] @default([])
  history                 String[] @default([])
  portrait                String?
  restrictedDepartmentIds String[] @default([])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  revisions               CharacterRevision[]
}

// Snapshot du contenu de Character juste AVANT chaque edition staff — meme
// principe que ScpRevision.
model CharacterRevision {
  id            String    @id @default(cuid())
  characterId   String
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  name          String
  title         String
  faction       String
  biography     String
  quotes        String[]
  history       String[]
  portrait      String?

  editedById    String?
  editedBy      User?     @relation(fields: [editedById], references: [id], onDelete: SetNull)
  editedByLabel String?
  createdAt     DateTime  @default(now())

  @@index([characterId])
}

// ─── REDLAKES CORE — evenements narratifs (GameEvent) ───────────────────────
// "type" reste une String libre (breach/invasion/guerre/crise-xk/experience)
// plutot qu'un enum Prisma : ces valeurs sont deja utilisees telles quelles
// (avec tiret) comme cles d'affichage cote web, un enum forcerait a les
// renommer (CRISE_XK) et casser cette correspondance pour aucun gain reel.

model GameEvent {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  title                   String
  date                    DateTime
  type                    String
  description             String
  casualties              String?
  outcome                 String
  restrictedDepartmentIds String[] @default([])
  factionId               String?
  faction                 Faction? @relation(fields: [factionId], references: [id], onDelete: SetNull)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  revisions               GameEventRevision[]
  linkedDocuments         ClassifiedDocument[] @relation("DocumentEvents")

  @@index([type])
  @@index([factionId])
}

// Snapshot du contenu de GameEvent juste AVANT chaque edition staff — meme
// principe que ScpRevision/CharacterRevision. Utile en particulier pour les
// brèches/crises (voir memoire "RP breach rarity") : le recit officiel d'un
// evenement rare doit pouvoir etre corrige sans perdre la version passee.
model GameEventRevision {
  id            String    @id @default(cuid())
  gameEventId   String
  gameEvent     GameEvent @relation(fields: [gameEventId], references: [id], onDelete: Cascade)

  title         String
  date          DateTime
  type          String
  description   String
  casualties    String?
  outcome       String

  editedById    String?
  editedBy      User?     @relation(fields: [editedById], references: [id], onDelete: SetNull)
  editedByLabel String?
  createdAt     DateTime  @default(now())

  @@index([gameEventId])
}

// ─── REDLAKES CORE — actualites (NewsArticle) ───────────────────────────────
// "category" reste une String libre (mise-a-jour/scp/evenement/lore), meme
// raisonnement que GameEvent.type : deja des cles de dictionnaire d'affichage
// cote web, un enum forcerait un renommage pour aucun gain. Le detail des
// articles reste minimal (excerpt seulement, pas de corps riche) — la page
// statique elle-meme notait deja "a connecter au CMS", jamais fait jusqu'ici.

model NewsArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  date      DateTime
  category  String
  image     String?
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions NewsRevision[]

  @@index([category])
  @@index([date])
}

// Snapshot du contenu de NewsArticle juste AVANT chaque edition staff — meme
// principe que ScpRevision/CharacterRevision/GameEventRevision (LOT F).
model NewsRevision {
  id            String      @id @default(cuid())
  newsArticleId String
  newsArticle   NewsArticle @relation(fields: [newsArticleId], references: [id], onDelete: Cascade)

  title    String
  excerpt  String
  date     DateTime
  category String
  image    String?
  featured Boolean

  editedById    String?
  editedBy      User?    @relation(fields: [editedById], references: [id], onDelete: SetNull)
  editedByLabel String?
  createdAt     DateTime @default(now())

  @@index([newsArticleId])
}

// ─── REDLAKES CORE — carte interactive (MapLocation) ────────────────────────
// "type" reste une String libre (site/surface/ville/egouts/...), meme
// raisonnement que GameEvent.type/NewsArticle.category. "faction" reste une
// String libre comme sur Character : les valeurs melangent factions reelles
// et groupes qui n'en sont pas (Main du Serpent, Chaos Insurgency, GOC).
// x/y sont des coordonnees en pourcentage (0-100) pour le positionnement
// absolu sur la carte cote client.

// ─── REDLAKES CORE — état système (System State) ────────────────────────────
// Source unique pour "le serveur est-il ouvert ?" / "recrutement ouvert ?" —
// remplace apps/web/src/config/site.ts (serverOpen/recruitmentOpen) et la
// variable d'environnement SERVER_OPEN du bot Discord, qui étaient deux
// copies éditées indépendamment sans synchronisation entre elles.
// Ligne unique (id fixe "singleton") plutôt qu'une table de config à clé/
// valeur générique : seulement 3 booléens à ce stade, pas besoin de plus.

// Niveau d'alerte RP affiché sur le site — distinct des flags ops
// (serverOpen/recruitmentOpen/maintenance) ci-dessus. Change UNIQUEMENT via
// une action staff explicite (voir SystemController, ADMIN uniquement) :
// jamais de calcul automatique, de minuteur ou de tirage aleatoire — les
// brèches et crises restent rares et decidees par le staff (voir memoire
// "RP breach rarity").
enum AlertLevel {
  NORMAL
  VIGILANCE
  ALERTE
  CRISE
}

model SystemState {
  id              String     @id @default("singleton")
  serverOpen      Boolean    @default(false)
  recruitmentOpen Boolean    @default(true)
  maintenance     Boolean    @default(false)
  alertLevel      AlertLevel @default(NORMAL)
  alertNote       String?
  alertUpdatedAt  DateTime?
  updatedAt       DateTime   @updatedAt
}

model MapLocation {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  type        String
  x           Float
  y           Float
  description String
  history     String
  danger      Int
  faction     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  revisions   MapLocationRevision[]

  @@index([type])
}

// Snapshot du contenu de MapLocation juste AVANT chaque edition staff.
model MapLocationRevision {
  id            String      @id @default(cuid())
  mapLocationId String
  mapLocation   MapLocation @relation(fields: [mapLocationId], references: [id], onDelete: Cascade)

  name        String
  type        String
  x           Float
  y           Float
  description String
  history     String
  danger      Int
  faction     String?

  editedById    String?
  editedBy      User?    @relation(fields: [editedById], references: [id], onDelete: SetNull)
  editedByLabel String?
  createdAt     DateTime @default(now())

  @@index([mapLocationId])
}
