DATABASE_URL="postgresql://redlakes_user:redlakes_password@localhost:5432/redlakes_db?schema=public"
JWT_SECRET="change-me-in-production-redlakes-jwt-secret"
JWT_EXPIRES_IN="7d"
API_PORT=3001
WEB_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# Microsoft OAuth (Minecraft Java Edition)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:3001/api/auth/microsoft/callback"

# Elasticsearch
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_INDEX="redlakes"

# Minecraft server
MINECRAFT_SERVER_IP="play.redlakes.fr"
MINECRAFT_SERVER_PORT="25565"

# Synchronisation rôles (plugin Minecraft + bot Discord optionnel)
SYNC_API_KEY="change-me-redlakes-sync-secret"

# Sel d'anonymisation des transmissions Discord → Site (codenames RP stables et
# non réversibles). Changez-le en production ; ne le partagez pas.
TRANSMISSION_SALT="change-me-redlakes-transmission-salt"

# Webhook Discord — annonces de grade SANS bot (recommandé pour commencer)
# Paramètres du salon → Intégrations → Webhooks → Nouveau webhook → copier l'URL
DISCORD_WEBHOOK_URL=""
# Webhook séparé pour les liaisons de compte (optionnel, sinon utilise DISCORD_WEBHOOK_URL)
DISCORD_WEBHOOK_LINK=""
# Webhook staff — rapports intranet + candidatures (optionnel, sinon DISCORD_WEBHOOK_URL)
DISCORD_WEBHOOK_STAFF=""

# Bot Discord — optionnel (sync roles RP + pseudo auto).
# Des que ces deux valeurs sont renseignees, la connexion site via Discord
# (voir DISCORD_CLIENT_ID plus bas) exige aussi d'etre membre de ce serveur —
# verifie a chaque connexion, pas seulement a la creation du compte.
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
# Surcharge manuelle optionnelle : {"Soldat Garde":"456"}
# Sinon l'API detecte automatiquement les roles RP par nom (comme le bot).
DISCORD_ROLE_MAP="{}"
# Role "compte lie" (optionnel)
ROLE_VERIFIED=""
# true = cree les roles RP manquants sur Discord (meme style que les existants)
DISCORD_AUTO_CREATE_ROLES="true"

# Connexion site via Discord OAuth2 (Developer Portal > OAuth2)
# Meme Application ID que le bot. Ajoute la redirect URI dans le portail :
# http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"
