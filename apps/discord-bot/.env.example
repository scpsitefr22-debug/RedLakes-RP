# === Bot Discord REDLAKES ===
# IMPORTANT : ne jamais committer le .env rempli. Si un token fuite, regenere-le.

# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_BOT_TOKEN=""

# Application ID (Discord Developer Portal > General Information > Application ID)
DISCORD_CLIENT_ID=""

# ID de ton serveur Discord (clic droit sur le serveur > Copier l'identifiant)
# Mode developpeur a activer : Parametres > Avances > Mode developpeur
DISCORD_GUILD_ID=""

# === Liaison avec l'API REDLAKES ===
# URL de l'API NestJS (le bot ajoute lui-meme les chemins /sync/...)
API_BASE_URL="http://localhost:3001/api"

# Doit etre IDENTIQUE a SYNC_API_KEY dans apps/api/.env
SYNC_API_KEY="change-me-redlakes-sync-secret"

# === Salons (IDs, optionnels — ou laisser vide pour auto-setup) ===
# Salon ou poster les promotions / changements de grade
CHANNEL_ANNOUNCES=""
# Salon de bienvenue pour les nouveaux membres
CHANNEL_WELCOME=""
# Salon de logs du bot (erreurs, liaisons)
CHANNEL_LOGS=""

# === Auto-setup salons STAFF TECHNIQUE ===
# true = le bot cree/retrouve la categorie et les salons au demarrage
DISCORD_AUTO_SETUP="true"
# test = categorie [TEST] + salons test-* | prod = noms finaux
DISCORD_SETUP_MODE="test"
# ID categorie existante (optionnel). Ex : categorie STAFF TECHNIQUE du serveur.
DISCORD_CATEGORY_STAFF="1156603335697244260"
# Nom categorie en mode prod (vide = defaut STAFF TECHNIQUE)
DISCORD_CATEGORY_NAME=""

# === Roles RP (auto-detection au demarrage) ===
# Le bot scanne les roles Discord et mappe ceux dont le nom correspond
# a un grade RP Site-12 (Soldat, Sergent, Scientifique, etc.).
# Staff, Membre, Joueur, Civil et roles techniques ne sont JAMAIS modifies.
# IDs supplementaires a ne jamais deplacer (separes par virgule) :
# DISCORD_PROTECTED_ROLE_IDS="123456789,987654321"
# DISCORD_ROLE_MAP sert uniquement de surcharge manuelle (optionnel) :
# Ex : {"Soldat Garde":"234567"}
DISCORD_ROLE_MAP="{}"
# Role "compte lie" (optionnel, hors grades RP)
ROLE_VERIFIED=""
# Sync STAFF automatique : tout membre ayant un role donnant une vraie
# permission Discord staff (Administrateur, Gerer le serveur, Gerer les
# roles, Bannir, Expulser, Moderer) est promu STAFF sur le site des qu'il a
# le role (et rattrape au demarrage du bot pour ceux qui l'ont deja).
# ROLE_STAFF (optionnel) ajoute des IDs de roles staff supplementaires SANS
# permission Discord reelle (role purement organisationnel). Plusieurs IDs
# possibles, separes par virgule. Jamais de retrogradation auto si un role
# est retire, et ADMIN reste toujours decide a la main sur le site.
ROLE_STAFF=""
# IDs des 4 roles Discord nommes de rang staff — precisent le rang envoye au
# site (au-dela du simple "a un role staff" ci-dessus). Le role Fondateur
# plafonne quand meme a Coordinateur Général cote site : ADMIN reste toujours
# decide a la main.
ROLE_RANK_SURVEILLANT=""
ROLE_RANK_OFFICIER=""
ROLE_RANK_COORDINATEUR_GENERAL=""
ROLE_RANK_FONDATEUR=""
# false par defaut : le bot s'adapte aux roles DEJA presents (noms proches OK)
# true = cree uniquement les grades sans aucun role correspondant
DISCORD_AUTO_CREATE_ROLES="false"
# false par defaut : le rangement auto a deja casse l'ordre des roles en prod.
# true = range roles + separateurs par departement (hierarchie Site-12) au demarrage
# et a chaque scan/import — utilise le bouton "Organiser" du hub (staff) a la place,
# c'est la meme logique mais declenchee volontairement.
DISCORD_AUTO_ORGANIZE_ROLES="false"

# === Pont Discord -> Site : "Transmissions de la Fondation" (theme SCP) ===
# Interrupteur global du relais (true par defaut). Mettre "false" pour desactiver.
DISCORD_TRANSMISSIONS="true"
# Relayer les arrivees / departs de membres (true par defaut)
DISCORD_RELAY_MEMBERS="true"
# Salons ecoutes -> classification RP affichee sur le site.
# JSON { "<channelId>": { "label": str, "clearance": 1-5, "public": bool, "kind": "message"|"announce"|"event" } }
# - label    : nom RP du secteur affiche sur le site
# - clearance: niveau d'habilitation requis pour lire la transmission (1 a 5)
# - public   : true => pseudo + extrait du message transmis ; false => metadonnees seules
# - kind     : "announce" pour les salons d'annonces, "message" sinon
# JSON sans guillemets echappes (Windows) — une seule ligne :
# DISCORD_CHANNEL_MAP={"ID_SALON":{"label":"Annonces","clearance":1,"public":true,"kind":"announce"}}
DISCORD_CHANNEL_MAP="{}"
# Active l'intent privilegie MessageContent (necessaire pour inclure un EXTRAIT
# des messages des salons publics). A n'activer QUE si l'intent est coche dans le
# Developer Portal (Bot > Privileged Gateway Intents > Message Content Intent),
# sinon le bot refusera de se connecter. Laisser "false" si non utilise.
DISCORD_ENABLE_MESSAGE_CONTENT="false"

# === Divers ===
# Lien d'invitation affiche dans certaines commandes
DISCORD_INVITE="https://discord.gg/d5DqcZEJkn"
# IP du serveur Minecraft
MINECRAFT_IP="play.redlakes.fr"
# Serveur ouvert ? (true/false) — change l'affichage du statut
SERVER_OPEN="false"
# URL du site
SITE_URL="http://localhost:3000"
